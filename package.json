{
  "name": "ojuken-hanamaru",
  "version": "1.0.0",
  "private": true,
  "description": "小学校受験（お受験）の準備を、分野別チェックリスト・おけいこ記録・志望校・面接想定問答で管理するアプリ",
  "scripts": {
    "build:css": "sass src/scss/style.scss css/style.css --no-source-map --style=compressed",
    "build:js": "esbuild src/ts/main.ts --bundle --minify --target=es2018 --format=iife --outfile=js/main.js",
    "build": "npm run build:css && npm run build:js",
    "dev": "sass --watch src/scss/style.scss:css/style.css",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "sass": "^1.77.6",
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "firebase": "^12.15.0"
  }
}
